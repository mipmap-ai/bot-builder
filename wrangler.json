{
  "name": "botbuilder",
  "main": "dist/server/index.js",
  "account_id": "85ee76520d41c14499e405c173047aec",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/mcp"
    ]
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "botbuilder-feedback"
    }
  ],
  "routes": [
    {
      "pattern": "botbuilder.mipmap.ai",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
